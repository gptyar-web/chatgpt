{
  "manifest_version": 3,
  "name": "GPT Yar",
  "version": "4.6.6",
  "description": "استفاده از جی‌پی‌تی پلاس بدون محدودیت و نیاز به وی‌پی‌ان",
  "permissions": [
    "cookies",
    "proxy",
    "declarativeNetRequest",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://*.chatgpt.com/*",
    "https://*.openai.com/*",
    "https://*.claude.ai/*",
    "https://*.auth.openai.com/*",
    "https://api.gptyar.com/*",
    "https://*.grok.com/*",
    "https://midjourney.com/*",
    "https://*.midjourney.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*"
      ],
      "js": [
        "chatgpt-spa-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*"
      ],
      "js": [
        "content-presence.js",
        "chatgpt-privacy-shield.js",
        "agent-content.js",
        "chatgpt-owned-navigation.js",
        "content-health.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://grok.com/*",
        "https://*.grok.com/*",
        "https://openai.com/*",
        "https://*.openai.com/*",
        "https://auth.openai.com/*",
        "https://*.auth.openai.com/*",
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://anthropic.com/*",
        "https://*.anthropic.com/*",
        "https://api.gptyar.com/*",
        "https://midjourney.com/*",
        "https://*.midjourney.com/*"
      ],
      "exclude_matches": [
        "https://auth.openai.com/*",
        "https://*.auth.openai.com/*"
      ],
      "js": [
        "content-presence.js",
        "agent-content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GPTYAR",
    "default_icon": "icons/icon.png"
  },
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/Vazirmatn.ttf",
        "icons/connection.png",
        "icons/icon.png"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ]
}
